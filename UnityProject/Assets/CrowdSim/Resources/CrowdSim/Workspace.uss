.workspace { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(0, 0, 0); }
.topbar { height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 6px; background-color: rgb(246, 245, 240); }
.brand { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; color: rgb(0, 0, 0); font-size: 17px; -unity-font-style: bold; }
.workspace-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.controls, .inspector { flex-shrink: 0; background-color: rgb(246, 245, 240); padding: 8px; }
.viewport { flex-grow: 1; min-width: 0; margin-left: 8px; margin-right: 8px; }
.page-scroll { flex-grow: 1; min-height: 0; }
.tabs { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.tabs Button { flex-grow: 1; min-width: 60px; }
.transport { min-height: 140px; flex-shrink: 0; background-color: rgb(246, 245, 240); padding: 8px; }
.actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.actions Button { min-width: 80px; }
.actions Slider { min-width: 220px; flex-grow: 1; }
.heading { font-size: 20px; margin: 10px 0; white-space: normal; }
.metrics { font-size: 14px; white-space: normal; margin: 10px 0; }
.muted, .readiness { font-size: 12px; color: rgb(0, 0, 0); white-space: normal; margin: 6px 0; }
.status { color: rgb(0, 0, 0); font-size: 12px; white-space: normal; }
.viewport-label { position: absolute; top: 8px; left: 8px; right: 8px; white-space: normal; color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); padding: 6px; }
.agent-open { position: absolute; top: 70px; left: 8px; }
Button { min-height: 30px; margin: 3px 2px; background-color: rgb(246, 245, 240); color: rgb(0, 0, 0); border-radius: 4px; border-color: rgb(74, 107, 132); border-width: 1px; white-space: normal; }
Button:hover, Button:focus { background-color: rgb(211, 229, 239); }
.unity-base-field { margin-top: 6px; margin-bottom: 6px; flex-direction: column; }
.unity-base-field__label { min-width: 0; white-space: normal; }
.file-path { font-size: 12px; white-space: normal; color: rgb(0, 0, 0); margin: 6px 0; }
.modal-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(246, 245, 240); align-items: center; justify-content: center; }
.modal-card { height: 80%; width: 520px; max-width: 90%; max-height: 90%; padding: 22px; background-color: rgb(246, 245, 240); border-color: rgb(74, 107, 132); border-width: 1px; border-radius: 7px; }

.radius-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.radius-row Button { min-width: 56px; flex-shrink: 0; }
.radius-text { flex-grow: 1; min-width: 50px; }
.invalid-radius .unity-text-field__input { border-color: rgb(255, 105, 90); border-width: 1px; }

/* Shared workspace hierarchy: light surfaces, blue actions and an emerald fume accent. */
.topbar { height: 60px; padding: 9px 12px; background-color: rgb(246, 245, 240); border-bottom-width: 1px; border-bottom-color: rgb(48, 64, 80); }
.brand { font-size: 15px; letter-spacing: 0.5px; }
.phase-badge { font-size: 10px; -unity-font-style: bold; color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); padding: 6px 10px; border-radius: 12px; margin-right: 12px; }
.phase-badge.is-running { color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); }
.controls, .inspector { background-color: rgb(246, 245, 240); padding: 10px; }
.tabs { padding-bottom: 9px; margin-bottom: 5px; border-bottom-width: 1px; border-bottom-color: rgb(47, 61, 76); }
.tabs Button { background-color: rgb(246, 245, 240); border-color: rgb(25, 36, 49); font-size: 12px; }
.tabs Button.tab-selected { color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); border-bottom-color: rgb(98, 189, 245); border-bottom-width: 2px; }
.heading { font-size: 23px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 8px; }
.section-title { font-size: 15px; -unity-font-style: bold; margin-top: 18px; margin-bottom: 6px; }
.eyebrow { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(0, 0, 0); margin-bottom: 6px; }
.metrics, .data-card { background-color: rgb(246, 245, 240); border-radius: 8px; padding: 12px; font-size: 13px; white-space: normal; margin: 7px 0; }
.workflow-card, .state-card { padding: 13px; margin: 9px 0; background-color: rgb(246, 245, 240); border-width: 1px; border-color: rgb(53, 95, 92); border-radius: 8px; white-space: normal; }
.state-card { color: rgb(0, 0, 0); border-color: rgb(116, 90, 52); background-color: rgb(246, 245, 240); }
.state-card.is-ready { color: rgb(0, 0, 0); border-color: rgb(48, 113, 92); background-color: rgb(246, 245, 240); }
.workflow-steps { font-size: 10px; color: rgb(0, 0, 0); white-space: normal; margin-bottom: 8px; }
Button { min-height: 33px; border-radius: 6px; font-size: 12px; padding: 5px 9px; background-color: rgb(246, 245, 240); border-color: rgb(58, 79, 99); }
Button.primary-button { background-color: rgb(211, 229, 239); border-color: rgb(74, 146, 195); -unity-font-style: bold; }
Button.primary-button:hover, Button.primary-button:focus { background-color: rgb(211, 229, 239); }
.scenario-fume Button.primary-button { background-color: rgb(205, 231, 216); border-color: rgb(58, 151, 118); }
.scenario-fume Button.primary-button:hover, .scenario-fume Button.primary-button:focus { background-color: rgb(205, 231, 216); }
Button:disabled { color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); border-color: rgb(43, 56, 70); }
.unity-base-field { margin-top: 8px; margin-bottom: 8px; }
.unity-base-field__label { color: rgb(0, 0, 0); font-size: 12px; }
.transport { padding: 10px 14px; border-top-width: 1px; border-top-color: rgb(52, 71, 91); }
.viewport-label { border-radius: 7px; padding: 9px 12px; font-size: 12px; background-color: rgb(246, 245, 240); }
.concentration-legend { height: 12px; flex-direction: row; margin-bottom: 9px; }
.legend-swatch { flex-grow: 1; }

Button.tool-active { border-color: rgb(113, 219, 179); border-width: 2px; color: rgb(0, 0, 0); }

/* M8: readable bundled sans serif, labelled states and a visible keyboard-focus boundary. */
.workspace { font-size: 14px; }
.muted, .readiness, .status, .file-path, .tabs Button, .unity-base-field__label, .viewport-label { font-size: 14px; }
.phase-badge, .eyebrow, .workflow-steps { font-size: 13px; letter-spacing: 0; }
Button { font-size: 14px; min-height: 36px; }
Button:focus { border-color: rgb(161, 219, 255); border-width: 2px; }
Button:disabled { color: rgb(0, 0, 0); }
.camera-card { background-color: rgb(246, 245, 240); padding: 10px; border-radius: 8px; margin: 8px 0; }
.camera-badge { position: absolute; bottom: 58px; left: 8px; padding: 6px 10px; color: rgb(0, 0, 0); background-color: rgb(246, 245, 240); font-size: 14px; border-radius: 6px; }
.leave-camera { position: absolute; bottom: 10px; left: 8px; }
.agent-legend-row { flex-direction: row; align-items: center; margin: 5px 0; }
.agent-legend-swatch { width: 16px; height: 16px; flex-shrink: 0; margin-right: 9px; border-color: rgb(173, 193, 208); border-width: 1px; border-radius: 3px; }
.agent-legend-text { color: rgb(0, 0, 0); font-size: 14px; white-space: normal; flex-shrink: 1; }

/* M9 user request: black type on light, warm architectural surfaces. */
.workspace { background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0); }
.workspace * { color: rgb(0, 0, 0); }
Button:focus, .unity-base-field:focus { border-color: rgb(20, 60, 85); }
.unity-text-field__input, .unity-base-popup-field__input, .unity-base-text-field__input { background-color: rgb(255, 254, 249); color: rgb(0, 0, 0); }

.diagnostic-card { background-color: rgb(255, 254, 249); border-radius: 7px; padding: 10px; margin: 6px 0; white-space: normal; font-size: 14px; }
.overlay-row { margin: 5px 0; }

.tabs Button.tab-selected { background-color: rgb(208, 226, 236); border-bottom-color: rgb(24, 74, 105); }
.phase-badge.is-running, .state-card.is-ready { background-color: rgb(205, 231, 216); }
.state-card { background-color: rgb(245, 227, 191); }
.controls, .inspector { border-color: rgb(204, 207, 201); border-width: 1px; }
Button:disabled { opacity: 1; color: rgb(0, 0, 0); background-color: rgb(233, 234, 229); }

.workspace .unity-text-element, .workspace .unity-button:hover, .workspace .unity-button:focus, .workspace .unity-button:disabled, .workspace .unity-disabled .unity-text-element, .workspace .unity-base-field__input:focus { color: rgb(0, 0, 0); }
