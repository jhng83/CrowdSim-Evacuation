.workspace { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(225, 234, 242); }
.topbar { height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 6px; background-color: rgb(17, 26, 37); }
.brand { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; color: rgb(100, 198, 246); font-size: 17px; -unity-font-style: bold; }
.workspace-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.controls, .inspector { flex-shrink: 0; background-color: rgb(17, 26, 37); padding: 8px; }
.viewport { flex-grow: 1; min-width: 0; margin-left: 8px; margin-right: 8px; }
.page-scroll { flex-grow: 1; min-height: 0; }
.tabs { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.tabs Button { flex-grow: 1; min-width: 60px; }
.transport { min-height: 140px; flex-shrink: 0; background-color: rgb(17, 26, 37); padding: 8px; }
.actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.actions Button { min-width: 80px; }
.actions Slider { min-width: 220px; flex-grow: 1; }
.heading { font-size: 20px; margin: 10px 0; white-space: normal; }
.metrics { font-size: 14px; white-space: normal; margin: 10px 0; }
.muted, .readiness { font-size: 12px; color: rgb(163, 190, 210); white-space: normal; margin: 6px 0; }
.status { color: rgb(246, 201, 117); font-size: 12px; white-space: normal; }
.viewport-label { position: absolute; top: 8px; left: 8px; right: 8px; white-space: normal; color: rgb(220, 238, 245); background-color: rgba(10, 20, 30, .8); padding: 6px; }
.agent-open { position: absolute; top: 70px; left: 8px; }
Button { min-height: 30px; margin: 3px 2px; background-color: rgb(36, 61, 81); color: rgb(225, 238, 247); border-radius: 4px; border-color: rgb(74, 107, 132); border-width: 1px; white-space: normal; }
Button:hover, Button:focus { background-color: rgb(48, 86, 115); }
.unity-base-field { margin-top: 6px; margin-bottom: 6px; flex-direction: column; }
.unity-base-field__label { min-width: 0; white-space: normal; }
.file-path { font-size: 12px; white-space: normal; color: rgb(163, 190, 210); margin: 6px 0; }
.modal-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5, 12, 20, 0.85); align-items: center; justify-content: center; }
.modal-card { height: 80%; width: 520px; max-width: 90%; max-height: 90%; padding: 22px; background-color: rgb(22, 35, 49); border-color: rgb(74, 107, 132); border-width: 1px; border-radius: 7px; }

.radius-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.radius-row Button { min-width: 56px; flex-shrink: 0; }
.radius-text { flex-grow: 1; min-width: 50px; }
.invalid-radius .unity-text-field__input { border-color: rgb(255, 105, 90); border-width: 1px; }

/* Shared workspace hierarchy: graphite surfaces, blue actions and an emerald fume accent. */
.topbar { height: 60px; padding: 9px 12px; background-color: rgb(15, 23, 33); border-bottom-width: 1px; border-bottom-color: rgb(48, 64, 80); }
.brand { font-size: 15px; letter-spacing: 0.5px; }
.phase-badge { font-size: 10px; -unity-font-style: bold; color: rgb(179, 199, 216); background-color: rgb(31, 45, 60); padding: 6px 10px; border-radius: 12px; margin-right: 12px; }
.phase-badge.is-running { color: rgb(119, 235, 190); background-color: rgb(22, 62, 51); }
.controls, .inspector { background-color: rgb(20, 29, 40); padding: 10px; }
.tabs { padding-bottom: 9px; margin-bottom: 5px; border-bottom-width: 1px; border-bottom-color: rgb(47, 61, 76); }
.tabs Button { background-color: rgb(25, 36, 49); border-color: rgb(25, 36, 49); font-size: 12px; }
.tabs Button.tab-selected { color: rgb(156, 215, 255); background-color: rgb(34, 57, 78); border-bottom-color: rgb(98, 189, 245); border-bottom-width: 2px; }
.heading { font-size: 23px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 8px; }
.section-title { font-size: 15px; -unity-font-style: bold; margin-top: 18px; margin-bottom: 6px; }
.eyebrow { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(133, 170, 198); margin-bottom: 6px; }
.metrics, .data-card { background-color: rgb(26, 39, 53); border-radius: 8px; padding: 12px; font-size: 13px; white-space: normal; margin: 7px 0; }
.workflow-card, .state-card { padding: 13px; margin: 9px 0; background-color: rgb(24, 44, 49); border-width: 1px; border-color: rgb(53, 95, 92); border-radius: 8px; white-space: normal; }
.state-card { color: rgb(242, 205, 140); border-color: rgb(116, 90, 52); background-color: rgb(49, 40, 30); }
.state-card.is-ready { color: rgb(140, 232, 196); border-color: rgb(48, 113, 92); background-color: rgb(23, 52, 45); }
.workflow-steps { font-size: 10px; color: rgb(142, 176, 193); white-space: normal; margin-bottom: 8px; }
Button { min-height: 33px; border-radius: 6px; font-size: 12px; padding: 5px 9px; background-color: rgb(34, 49, 66); border-color: rgb(58, 79, 99); }
Button.primary-button { background-color: rgb(40, 95, 139); border-color: rgb(74, 146, 195); -unity-font-style: bold; }
Button.primary-button:hover, Button.primary-button:focus { background-color: rgb(44, 104, 149); }
.scenario-fume Button.primary-button { background-color: rgb(29, 99, 79); border-color: rgb(58, 151, 118); }
.scenario-fume Button.primary-button:hover, .scenario-fume Button.primary-button:focus { background-color: rgb(30, 115, 91); }
Button:disabled { color: rgb(117, 139, 156); background-color: rgb(28, 39, 51); border-color: rgb(43, 56, 70); }
.unity-base-field { margin-top: 8px; margin-bottom: 8px; }
.unity-base-field__label { color: rgb(182, 202, 219); font-size: 12px; }
.transport { padding: 10px 14px; border-top-width: 1px; border-top-color: rgb(52, 71, 91); }
.viewport-label { border-radius: 7px; padding: 9px 12px; font-size: 12px; background-color: rgba(13, 24, 36, .92); }
.concentration-legend { height: 12px; flex-direction: row; margin-bottom: 9px; }
.legend-swatch { flex-grow: 1; }

Button.tool-active { border-color: rgb(113, 219, 179); border-width: 2px; color: rgb(162, 242, 209); }

/* M8: readable bundled sans serif, labelled states and a visible keyboard-focus boundary. */
.workspace { font-size: 14px; }
.muted, .readiness, .status, .file-path, .tabs Button, .unity-base-field__label, .viewport-label { font-size: 14px; }
.phase-badge, .eyebrow, .workflow-steps { font-size: 13px; letter-spacing: 0; }
Button { font-size: 14px; min-height: 36px; }
Button:focus { border-color: rgb(161, 219, 255); border-width: 2px; }
Button:disabled { color: rgb(159, 178, 194); }
.camera-card { background-color: rgb(26, 39, 53); padding: 10px; border-radius: 8px; margin: 8px 0; }
.camera-badge { position: absolute; bottom: 58px; left: 8px; padding: 6px 10px; color: rgb(225, 238, 247); background-color: rgba(13, 24, 36, .94); font-size: 14px; border-radius: 6px; }
.leave-camera { position: absolute; bottom: 10px; left: 8px; }
.agent-legend-row { flex-direction: row; align-items: center; margin: 5px 0; }
.agent-legend-swatch { width: 16px; height: 16px; flex-shrink: 0; margin-right: 9px; border-color: rgb(173, 193, 208); border-width: 1px; border-radius: 3px; }
.agent-legend-text { color: rgb(225, 234, 242); font-size: 14px; white-space: normal; flex-shrink: 1; }
